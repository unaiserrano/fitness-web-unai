# Copia este archivo como .env.local y rellénalo.

# Base de datos Postgres (Neon). En Vercel se rellena sola al conectar Neon en Storage.
# Si la dejas vacía en local, se usa una base de datos en el archivo .data/pglite (no hay que instalar nada).
DATABASE_URL=

# Contraseña para entrar en la app (solo la usas tú). En Vercel es obligatoria.
APP_PASSWORD=

# Secreto para firmar la sesión. OBLIGATORIO en producción, mínimo 32 caracteres (openssl rand -base64 32).
AUTH_SECRET=

# (Opcional) Carpeta de la base de datos local cuando no hay DATABASE_URL. Por defecto .data/pglite.
# PGLITE_DIR=
